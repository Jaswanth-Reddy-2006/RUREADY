// ═══════════════════════════════════════════════════════════════
// Auth Microservice — Prisma Schema
// Data ownership: users, refresh_tokens
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenId   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([userId, tokenId])
  @@index([userId])
  @@map("refresh_tokens")
}
