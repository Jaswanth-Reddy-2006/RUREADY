generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Roadmap {
  id             String                @id @default(cuid())
  ownerId        String
  creatorName    String?
  title          String
  description    String?
  goal           String?
  category       String?
  difficulty     String?
  estimatedWeeks Int?
  tags           Json?
  cloneCount     Int                   @default(0)
  viewCount      Int                   @default(0)
  status         String                @default("DRAFT")
  isPublished    Boolean               @default(false)
  publishedAt    DateTime?
  share          RoadmapShare?
  nodes          RoadmapNode[]
  collaborators  RoadmapCollaborator[]
  progress       RoadmapProgress[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([ownerId])
  @@index([status])
  @@map("roadmaps")
}

model RoadmapNode {
  id          String            @id @default(cuid())
  roadmapId   String
  title       String
  description String?
  type        String            @default("TOPIC")
  position    Int               @default(0)
  metadata    Json?
  roadmap     Roadmap           @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      RoadmapNode?      @relation("RoadmapNodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    RoadmapNode[]     @relation("RoadmapNodeTree")
  progress    RoadmapProgress[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([roadmapId, position])
  @@index([parentId])
  @@map("roadmap_nodes")
}

model RoadmapCollaborator {
  id        String    @id @default(cuid())
  roadmapId String
  userId    String?
  email     String
  role      String    @default("VIEWER")
  status    String    @default("PENDING")
  invitedAt DateTime  @default(now())
  joinedAt  DateTime?
  roadmap   Roadmap   @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@unique([roadmapId, email])
  @@index([userId])
  @@map("roadmap_collaborators")
}

model RoadmapProgress {
  id          String      @id @default(cuid())
  roadmapId   String
  nodeId      String
  userId      String
  status      String      @default("NOT_STARTED")
  percent     Int         @default(0)
  notes       String?
  completedAt DateTime?
  roadmap     Roadmap     @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  node        RoadmapNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  updatedAt   DateTime    @updatedAt
  createdAt   DateTime    @default(now())

  @@unique([nodeId, userId])
  @@index([roadmapId, userId])
  @@map("roadmap_progress")
}

model RoadmapTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String?
  isPublic    Boolean  @default(true)
  authorId    String?
  definition  Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, isPublic])
  @@map("roadmap_templates")
}

model RoadmapShare {
  id        String    @id @default(cuid())
  roadmapId String    @unique
  token     String    @unique @default(cuid())
  expiresAt DateTime?
  access    String    @default("VIEW")
  createdAt DateTime  @default(now())
  roadmap   Roadmap   @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@map("roadmap_shares")
}
