// ═══════════════════════════════════════════════════════════════
// Coding Interview & Sandbox Microservice — Prisma Schema
// Data ownership: coding_sessions, pre_defined_problems, code_execution_deltas
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CodingSession {
  id               String    @id @default(cuid())
  userId           String
  targetRole       String
  focusTrack       String?   @default("DSA") // DSA, MACHINE_CODING, SQL, FRONTEND, BACKEND
  problemId        String?
  difficulty       String    @default("MEDIUM")
  selectedLanguage String    @default("javascript")
  durationMins     Int       @default(30)
  status           String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, ABANDONED
  testCasesPassed  Int?      @default(0)
  totalTestCases   Int?      @default(0)
  overallScore     Int?
  feedbackSummary  String?
  startedAt        DateTime  @default(now())
  completedAt      DateTime?

  executionDeltas CodeExecutionDelta[]

  @@index([userId, status])
  @@map("coding_sessions")
}

model PreDefinedProblem {
  id              String   @id @default(uuid())
  title           String
  difficulty      String   @default("MEDIUM")
  pattern         String
  category        String?  @default("DSA")
  topicTags       String[] @default([])
  description     String   @db.Text
  starterCode     Json
  testCases       Json
  optimalSolution String   @db.Text
  optimalTime     String
  optimalSpace    String
  createdAt       DateTime @default(now())

  @@index([difficulty, pattern])
  @@map("pre_defined_problems")
}

model CodeExecutionDelta {
  id        String        @id @default(uuid())
  sessionId String
  session   CodingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  code      String        @db.Text
  language  String
  output    String?       @db.Text
  success   Boolean?
  timestamp DateTime      @default(now())

  @@index([sessionId, timestamp])
  @@map("code_execution_deltas")
}
