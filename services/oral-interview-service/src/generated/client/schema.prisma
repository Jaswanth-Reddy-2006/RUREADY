// ═══════════════════════════════════════════════════════════════
// Video & Oral Interview Microservice — Prisma Schema
// Data ownership: oral_sessions, oral_questions, oral_chat_history
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OralSession {
  id              String    @id @default(cuid())
  userId          String
  resumeId        String?
  interviewType   String
  targetRole      String
  targetCompany   String?
  industry        String
  experienceLevel String    @default("MID") // FRESHER, MID, SENIOR, LEAD
  focusAreas      String[]  @default([])
  interviewGoal   String?
  durationMins    Int       @default(20)
  status          String    @default("SETUP") // SETUP, IN_PROGRESS, COMPLETED, ABANDONED
  overallScore    Int?
  feedbackSummary String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  questions   OralQuestion[]
  chatHistory OralChatHistory[]

  @@index([userId, status])
  @@map("oral_sessions")
}

model OralQuestion {
  id             String      @id @default(cuid())
  sessionId      String
  session        OralSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  orderIndex     Int
  questionText   String
  questionType   String
  category       String?     @default("TECHNICAL") // BEHAVIORAL, TECHNICAL, SYSTEM_DESIGN, SITUATIONAL
  difficulty     String      @default("MEDIUM")
  answerText     String?
  answeredAt     DateTime?
  timeTakenSecs  Int?
  evalScore      Int?
  evalFeedback   String?
  evalStrengths  String[]    @default([])
  evalWeaknesses String[]    @default([])
  betterAnswer   String?

  @@index([sessionId])
  @@map("oral_questions")
}

model OralChatHistory {
  id        String      @id @default(uuid())
  sessionId String
  session   OralSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String
  score     Int?
  critique  String?
  timestamp DateTime    @default(now())

  @@index([sessionId, timestamp])
  @@map("oral_chat_history")
}
