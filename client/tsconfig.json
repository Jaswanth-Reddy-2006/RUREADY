{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@ru-ready/shared": ["../packages/shared/src/types/index.ts"],
      "@ru-ready/shared/*": ["../packages/shared/src/types/*"]
    }
  },
  "include": ["src", "../packages/shared/src"]
}
