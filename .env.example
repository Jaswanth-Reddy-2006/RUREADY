# ═══════════════════════════════════════════════════════════════
# R U Ready? — Environment Variable Master Template (.env.example)
# ═══════════════════════════════════════════════════════════════

# ─── Database ───
DATABASE_URL=postgresql://ruready:ruready_dev_pass@localhost:5432/ru_ready

# ─── JWT Authentication Secrets ───
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production

# ─── Centralized AI Engine & LLM Provider (Meta Llama via Ollama) ───
AI_PROVIDER=ollama                          # Options: 'ollama' | 'mock'
AI_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1 # Local Ollama API endpoint
AI_OLLAMA_MODEL=llama3.1                    # Meta Llama: 'llama3.1' (8B) or 'llama3.2:1b'

# ─── File Storage (Resumes & Audio Records) ───
STORAGE_MODE=local                          # Options: 'local' | 's3'
# Required only if STORAGE_MODE=s3
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=ru-ready-resumes
AWS_S3_REGION=us-east-1

# ─── Service Ports ───
PORT=4000
AUTH_SERVICE_PORT=4001
ORAL_INTERVIEW_SERVICE_PORT=4002
AI_SERVICE_PORT=4003
ANALYTICS_SERVICE_PORT=4004
USER_SERVICE_PORT=4005
CODING_INTERVIEW_SERVICE_PORT=4006
PAYMENT_SERVICE_PORT=4007
ADMIN_SERVICE_PORT=4008

# ─── Gateway Downstream Microservice Ingress URLs ───
AUTH_SERVICE_URL=http://localhost:4001
ORAL_INTERVIEW_SERVICE_URL=http://localhost:4002
AI_SERVICE_URL=http://localhost:4003
ANALYTICS_SERVICE_URL=http://localhost:4004
USER_SERVICE_URL=http://localhost:4005
CODING_INTERVIEW_SERVICE_URL=http://localhost:4006
PAYMENT_SERVICE_URL=http://localhost:4007
ADMIN_SERVICE_URL=http://localhost:4008

# ─── Payment Provider Integrations ───
PAYMENT_PROVIDER_KEY=sk_test_mock_key
PAYMENT_WEBHOOK_SECRET=whsec_mock_secret
# Production Stripe / Razorpay overrides:
STRIPE_SECRET_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ─── Core Environment & Security ───
NODE_ENV=development                        # 'development' | 'production' | 'test'
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ─── Frontend Config (Client Ingress) ───
VITE_API_BASE_URL=http://localhost:4000/api
