# ─── Database ───
DATABASE_URL=postgresql://ruready:ruready_dev_pass@localhost:5432/ru_ready

# ─── JWT ───
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production

# ─── AI API (OpenAI-compatible route) ───
AI_API_KEY=your-ai-api-key
AI_API_BASE_URL=https://your-ai-endpoint.com/v1
AI_MODEL=gpt-4
AI_MOCK=true

# ─── File Storage ───
# For local dev, files are saved to ./uploads
# For production, configure S3:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=ru-ready-resumes
# AWS_S3_REGION=us-east-1
STORAGE_MODE=local

# ─── Server ───
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ─── Frontend (prefix with VITE_) ───
VITE_API_BASE_URL=http://localhost:4000/api
